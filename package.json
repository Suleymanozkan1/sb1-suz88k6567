{
  "name": "sahratakip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sahra Takip - Düğün Salonu Rezervasyon ve Ödeme Takip Sistemi",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:sunucu",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --force --pretty",
    "test": "vitest run && npm run test:mobil",
    "test:web": "vitest run",
    "test:mobil": "npm --prefix mobil test",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:sunucu": "tsc -p tsconfig.sunucu.json && node -e \"require('fs').copyFileSync('sunucu/derleme-paketi.json','sunucu-dist/package.json')\"",
    "baslat": "node sunucu-dist/sunucu/baslat.js",
    "vercel-build": "tsc -b && vite build",
    "demo:veri": "tsx scripts/demo-veri-uret.ts",
    "goc": "tsx scripts/goc-uygula.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@whiskeysockets/baileys": "^6.7.24",
    "pg": "^8.23.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
