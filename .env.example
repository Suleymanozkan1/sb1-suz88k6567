# ---------------------------------------------------------------------
# Düğün Takip — ortam değişkenleri
#
# Yerel geliştirme için bu dosyayı `.env.local` olarak kopyalayın.
# Vercel'de: Settings → Environment Variables
# ---------------------------------------------------------------------

# --- Veritabanı (Supabase) ------------------------------------------
# Boş bırakılırsa uygulama DEMO MODUNDA çalışır: veriler yalnızca
# tarayıcıda saklanır ve arayüzde uyarı gösterilir.
# Supabase → Project Settings → API bölümünden alınır.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Kayıt olma -------------------------------------------------------
# Sistemi yalnızca kendi şirketiniz için kullanıyorsanız kapalı bırakın.
# Hesapları Supabase → Authentication → Users bölümünden açarsınız.
VITE_ALLOW_SIGNUP=false

# --- SMS sağlayıcısı (Netgsm) — YALNIZCA SUNUCU TARAFI ----------------
# Bu değişkenler VITE_ öneki taşımaz; tarayıcıya asla gönderilmezler.
# Tanımlı değilse SMS gönderilmez, mesajlar yalnızca kayıt altına alınır
# ve arayüzde "gönderilemedi" bilgisi gösterilir.
NETGSM_USER=
NETGSM_PASS=
NETGSM_HEADER=

# --- Giriş SMS doğrulaması -------------------------------------------
# Rastgele, en az 32 karakter. Üretmek için:
#   openssl rand -hex 32
# Tanımlı değilse iki adımlı doğrulama devre dışı kalır.
OTP_SECRET=

# --- Sunucu tarafı güvenlik ------------------------------------------
# Giriş kilidi ve hız sınırı, service_role yetkisi gerektiren veritabanı
# fonksiyonlarını çağırır. Tanımlı değilse bu korumalar devre dışı kalır.
# Supabase → Project Settings → API → service_role key
# DİKKAT: Bu anahtar RLS'yi atlar, asla VITE_ öneki ile tanımlamayın.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Hata izleme (isteğe bağlı) --------------------------------------
# Tanımlı değilse hiçbir dış servise istek gitmez.
VITE_SENTRY_DSN=
