{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "vercel-api/demo-gunler.ts",
      "use": "@vercel/node"
    },
    {
      "src": "vercel-api/demo-hava.ts",
      "use": "@vercel/node"
    },
    {
      "src": "vercel-api/saglik.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/demo-gunler",
      "dest": "/vercel-api/demo-gunler.ts"
    },
    {
      "src": "/api/demo-hava",
      "dest": "/vercel-api/demo-hava.ts"
    },
    {
      "src": "/api/saglik",
      "dest": "/vercel-api/saglik.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/demo-gunler",
      "schedule": "30 4 4 * *"
    },
    {
      "path": "/api/demo-hava",
      "schedule": "0 5 * * *"
    }
  ]
}
