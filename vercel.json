{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_not": "Vercel YALNIZCA demo içindir: derlenmiş statik site sunulur, sunucu tarafı çalışmaz.",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
