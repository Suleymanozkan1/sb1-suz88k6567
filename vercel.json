{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "vercel-api/demo-gunler.ts",
      "use": "@vercel/node"
    },
    {
      "src": "vercel-api/demo-hava.ts",
      "use": "@vercel/node"
    },
    {
      "src": "vercel-api/demo-kur.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.de.sentry.io; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "/(assets|fonts)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/api/demo-gunler",
      "dest": "/vercel-api/demo-gunler.ts"
    },
    {
      "src": "/api/demo-hava",
      "dest": "/vercel-api/demo-hava.ts"
    },
    {
      "src": "/api/demo-kur",
      "dest": "/vercel-api/demo-kur.ts"
    },
    {
      "src": "/veri/(.*)",
      "dest": "/api/index.ts?__yol=/veri/$1"
    },
    {
      "src": "/veri",
      "dest": "/api/index.ts?__yol=/veri"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts?__yol=/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/demo-gunler",
      "schedule": "30 4 4 * *"
    },
    {
      "path": "/api/demo-hava",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/demo-kur",
      "schedule": "0 13 * * 1-5"
    }
  ]
}
